 DRV.forEach(function(i){var s=+(i.scenes!==undefined?i.scenes:i.adegan),d=+(i.duration!==undefined?i.duration:i.durasi);
  if(isFinite(s)&&s>0&&isFinite(d)&&d>0&&!(DRVM[i.id]&&!DRVM[i.id].est))DRVM[i.id]={scenes:s,duration:Math.round(d),est:false}})};
/* hitung dari isi proyek (perkiraan) */
async function pjStat(id){var j=JSON.parse(await rpc('loadProject',id)),sc=j.scenes||[],tot=0,i,k,e,d,a,c,ni,nn;
 for(i=0;i<sc.length;i++){e=sc[i];d=3.5;
  if(e.layout==='pembuka'||e.layout==='penutup')d=6.5;
  if(e.layout==='gerak')d=Math.max(d,e.gd||10);
  if(e.layout==='foto'){ni=(e.imgs&&e.imgs.length)||1;nn=String(e.body||'').replace(/\s/g,'').length;d=Math.max(4,ni>1?2.8*ni+1.5:4,nn/14+3)}
  if(e.audio&&e.audio.b64){try{a=await AC().decodeAudioData(u8(e.audio.b64).buffer.slice(0));d=Math.max(d,a.duration+.8)}catch(er){}}
  for(k=0;k<(e.cues||[]).length;k++){c=e.cues[k];if(c.audio&&c.audio.b64){try{a=await AC().decodeAudioData(u8(c.audio.b64).buffer.slice(0));d=Math.max(d,(c.vt-(e.vs||0))+a.duration+.8)}catch(er){}}}
  if(e.vd>0)d=e.vd;
  d=Math.max(d,e.amD||0);tot+=d}
 return{scenes:sc.length,duration:Math.round(tot),est:true}}
/* isi kolom Adegan & Durasi pada baris "Di Drive" */
var _pbdr=drafts;
drafts=async function(){await _pbdr();
 var tb=$('dtb'),L=db?await metaAll():[],have={},ex,off=L.length;
 L.forEach(function(m){if(m.driveId)have[m.driveId]=1});
 ex=DRV.filter(function(i){return!have[i.id]});if(!ex.length)return;
 ex.forEach(function(it,k){var tr=tb.children[off+k];if(!tr||tr.children.length<3)return;var c=tr.children,st=DRVM[it.id];
  if(st){c[1].textContent=st.scenes;c[2].textContent=(st.est?'≈ ':'')+pjFmt(st.duration)}
  else{c[1].textContent='';var b=document.createElement('button');b.type='button';b.className='b';b.textContent='Hitung';b.title='Hitung adegan & durasi dari isi proyek';
   b.onclick=async function(){if(busy||loading)return;busy=true;
    try{msg('Menghitung durasi "'+it.name+'"...');DRVM[it.id]=await pjStat(it.id);msg('Durasi dihitung.')}catch(e){msg('Gagal menghitung: '+(e.message||e),1)}
    busy=false;await drafts()};
   c[1].appendChild(b)}})};
/* tombol hitung semua */
(function(){var row=document.querySelector('.app + section .row');if(!row)return;
 var b=document.createElement('button');b.type='button';b.className='b';b.textContent='Hitung durasi semua';
 b.onclick=async function(){if(busy||loading)return;var todo=DRV.filter(function(i){return!DRVM[i.id]}),n=todo.length,k;
  if(!n){msg('Semua durasi proyek sudah diketahui.');return}
  busy=true;
  try{for(k=0;k<n;k++){msg('Menghitung durasi '+(k+1)+' dari '+n+' ('+Math.round(k/n*100)+'%): '+todo[k].name);
    try{DRVM[todo[k].id]=await pjStat(todo[k].id)}catch(er){}
    await drafts()}
   msg('Durasi '+n+' proyek selesai dihitung (tanda ≈ = perkiraan).')}
  catch(e){msg('Gagal menghitung: '+(e.message||e),1)}
  busy=false;await drafts()};
 row.insertBefore(b,row.lastChild)})();
